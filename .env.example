# Copier ce fichier en « .env » puis adapter les valeurs. Le fichier .env n'est jamais publié.
# Sur Vercel, ces variables se saisissent dans Settings → Environment Variables.

# Base de données.
#   En local : laisser vide ou sqlite:///bourse.db (fichier bourse.db du projet).
#   En ligne : adresse PostgreSQL fournie par Neon ou Supabase, par exemple
#   postgresql://utilisateur:motdepasse@hote/base?sslmode=require
DATABASE_URL=sqlite:///bourse.db

# Clé du LLM. Inutile avec Ollama installé sur l'ordinateur (laisser vide).
# Nécessaire pour un service Ollama hébergé, seule possibilité sur Vercel :
#   LLM_URL=https://ollama.com, LLM_MODELE=<un modèle proposé par le service>, LLM_API_KEY=<clé>
# Sans LLM joignable, les titres sont notés par le lexique de mots-clés.
LLM_API_KEY=

# Nom affiché dans le conseil final.
NOM_CLIENT=Monsieur Dupont

# Secret qui protège la route /api/refresh (mise à jour automatique des données).
# Une longue chaîne aléatoire, par exemple : python -c "import secrets; print(secrets.token_urlsafe(32))"
# La même valeur doit être enregistrée dans les secrets GitHub (REFRESH_SECRET).
REFRESH_SECRET=

# Module Information : LLM via l'API d'Ollama.
#   en local : https://ollama.com puis « ollama pull qwen2.5:7b »
#   ordinateur modeste : « ollama pull llama3.2:3b » et LLM_MODELE=llama3.2:3b
LLM_MODELE=qwen2.5:7b
LLM_URL=http://localhost:11434
# LLM_ACTIF=non   -> n'utilise que le lexique de mots-clés
